# ──────────────────────────────────────────────────────────────
#  Variables de entorno — Plataforma Lucy Tejada + SGE
#  Copia este archivo como .env y ajusta los valores
# ──────────────────────────────────────────────────────────────

# ── Opción A: Supabase (recomendado) ──────────────────────────
# Obtén estos valores en: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ejemplo:
# VITE_SUPABASE_URL=https://xyzabcdef.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Opción B: Backend REST propio ────────────────────────────
# (Solo si NO usas Supabase; Supabase tiene prioridad)
VITE_API_BASE_URL=

# Ejemplo:
# VITE_API_BASE_URL=http://localhost:3000/api
